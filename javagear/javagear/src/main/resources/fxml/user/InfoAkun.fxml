<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.javagear.controllers.InfoAkunController"
            prefWidth="1200" prefHeight="700"
            stylesheets="@../../css/user/styleuser.css">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="15">
            <Button text="← KEMBALI KE MENU" onAction="#handleBack" 
                    style="-fx-background-color: transparent; -fx-text-fill: #1A5D34; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="INFO AKUN &amp; TAGIHAN" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="30" style="-fx-padding: 30; -fx-background-color: #F5F7FA;">
            
            <VBox spacing="20" prefWidth="350">
                <VBox fx:id="cardProfil" styleClass="card-profil" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS"
                      style="-fx-padding: 40 30; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    
                    <Circle fx:id="circleProfil" radius="60" stroke="#ecf0f1" strokeWidth="4" fill="LIGHTGRAY"/>
                    
                    <Button text="📷 Ubah Foto" onAction="#handleUbahProfil" 
                            style="-fx-background-color: #ecf0f1; -fx-text-fill: #7f8c8d; -fx-font-size: 10px; -fx-cursor: hand; -fx-background-radius: 20;"/>

                    <VBox alignment="CENTER" spacing="2">
                        <Label fx:id="lblNama" text="Nama User" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                        <Label fx:id="lblUsername" text="\@username" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                    </VBox>
                    
                    <Region prefHeight="10"/>

                    <ImageView fx:id="imgBadgeBig" fitHeight="75" fitWidth="75" preserveRatio="true"/>
                    
                    <Label fx:id="lblStatusMember" text="Member" 
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-background-color: #f0f0f0; -fx-padding: 5 15; -fx-background-radius: 15;"/>
                    
                    <Region VBox.vgrow="ALWAYS" /> 

                    <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 20 0 0 0; -fx-border-color: #ecf0f1; -fx-border-width: 1 0 0 0; -fx-pref-width: 100%;">
                        <VBox>
                            <Label text="Email:" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                            <Label fx:id="lblEmail" text="user@email.com" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        </VBox>
                        <VBox>
                            <Label text="WhatsApp:" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;"/>
                            <Label fx:id="lblTelepon" text="0812xxxx" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="20">
                
                <HBox spacing="20" prefHeight="160">
                    <VBox HBox.hgrow="ALWAYS" spacing="10" 
                          style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                        <Label text="DOMPET SAYA" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
                        <Label fx:id="lblSaldo" text="Rp 0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <HBox spacing="10">
                            <TextField fx:id="fieldTopUp" promptText="Nominal..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 5;"/>
                            <Button text="💳 TOP UP" onAction="#handleTopUp" style="-fx-background-color: #1A5D34; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5;"/>
                        </HBox>
                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" spacing="10" 
                          style="-fx-padding: 20; -fx-background-color: #ffebee; -fx-background-radius: 15; -fx-border-color: #ef9a9a; -fx-border-radius: 15; -fx-border-width: 1;">
                        <Label text="TAGIHAN DENDA" style="-fx-font-weight: bold; -fx-text-fill: #c0392b; -fx-font-size: 12px;"/>
                        <Label fx:id="lblTotalDenda" text="Rp 0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #c0392b;"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button fx:id="btnBayarDenda" text="✅ AMAN" onAction="#handleBayarDenda" maxWidth="Infinity" 
                                style="-fx-background-color: #ef9a9a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" disable="true"/>
                    </VBox>
                </HBox>

                <VBox VBox.vgrow="ALWAYS" spacing="10" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="📜 RIWAYAT PENYEWAAN" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="📄 CETAK STRUK" onAction="#handleCetakStruk" styleClass="btn-action"/>
                    </HBox>

                    <TableView fx:id="tabelRiwayat" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <columns>
                            <TableColumn fx:id="colBarang" text="Barang" prefWidth="250"/>
                            <TableColumn fx:id="colTanggal" text="Tgl Pinjam" prefWidth="120"/>
                            <TableColumn fx:id="colBiayaSewa" text="Harga Sewa" prefWidth="120"/>
                            <TableColumn fx:id="colDenda" text="Denda" prefWidth="100"/>
                            <TableColumn fx:id="colStatus" text="Status Barang" prefWidth="150"/>
                            <TableColumn fx:id="colStatusBayar" text="Pembayaran" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>

            </VBox>

        </HBox>
    </center>

</BorderPane>