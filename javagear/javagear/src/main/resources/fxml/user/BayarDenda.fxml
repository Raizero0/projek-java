<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="10" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.javagear.controllers.BayarDendaController"
      prefWidth="420"
      style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #1A5D34; -fx-border-width: 2;">
    
    <Label text="💰 PEMBAYARAN DENDA" textFill="#2c3e50">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
    </Label>

    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 10; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
        <Label text="📊 PROGRESS PEMBAYARAN" textFill="#34495e" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
        
        <ProgressBar fx:id="progressDenda" prefWidth="380" progress="0.0" 
                     style="-fx-accent: #27ae60; -fx-pref-height: 15;"/>

        <ListView fx:id="listDetailDenda" prefHeight="100" 
                  style="-fx-background-color: #F5F7FA; -fx-border-color: #ecf0f1; -fx-border-radius: 3; -fx-font-size: 11px;"/>

        <HBox spacing="20" alignment="CENTER">
            <VBox spacing="2" alignment="CENTER">
                <Label text="TOTAL" textFill="#7f8c8d" style="-fx-font-weight: bold; -fx-font-size: 10;"/>
                <Label fx:id="lblTotalDenda" text="Rp 0" textFill="#e74c3c" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            </VBox>
            <VBox spacing="2" alignment="CENTER">
                <Label text="SISA TAGIHAN" textFill="#7f8c8d" style="-fx-font-weight: bold; -fx-font-size: 10;"/>
                <Label fx:id="lblSisaDenda" text="Rp 0" textFill="#f39c12" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox spacing="5" style="-fx-background-color: #fff9e6; -fx-padding: 10; -fx-border-color: #f39c12; -fx-border-radius: 5;">
        <HBox spacing="5" alignment="CENTER_LEFT">
            <Label text="ℹ️" style="-fx-font-size: 14;"/>
            <Label fx:id="lblInfoDenda" text="Memuat info..." 
                   style="-fx-text-fill: #8e6c0e; -fx-wrap-text: true; -fx-font-size: 11;"/>
        </HBox>
    </VBox>

    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
        <Label text="💳 ISI DATA BAYAR" textFill="#34495e" style="-fx-font-weight: bold; -fx-font-size: 12;"/>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="ID Bayar:" prefWidth="90" textFill="#7f8c8d" style="-fx-font-size: 11;"/>
            <Label fx:id="lblIdPembayaran" text="-" 
                   style="-fx-text-fill: #2c3e50; -fx-font-weight: bold; -fx-font-size: 11; -fx-background-color: #F5F7FA; -fx-padding: 2 5; -fx-background-radius: 3;"/>
        </HBox>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Metode:" prefWidth="90" textFill="#2c3e50" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
            <ComboBox fx:id="comboMetodeBayar" prefWidth="200" style="-fx-font-size: 11;"/>
        </HBox>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Nominal:" prefWidth="90" textFill="#2c3e50" style="-fx-font-weight: bold; -fx-font-size: 11;"/>
            <TextField fx:id="txtNominalBayar" prefWidth="120" promptText="Rp..." style="-fx-font-size: 11;"/>
            <VBox>
                <Label text="Kembali:" textFill="#7f8c8d" style="-fx-font-size: 9;"/>
                <Label fx:id="lblKembalian" text="Rp 0" style="-fx-font-weight: bold; -fx-font-size: 11; -fx-text-fill: #27ae60;"/>
            </VBox>
        </HBox>
    </VBox>

    <Label fx:id="lblError" text="" textFill="#e74c3c" style="-fx-font-weight: bold; -fx-wrap-text: true; -fx-font-size: 10;" visible="false"/>

    <HBox spacing="15" alignment="CENTER">
        <Button text="BATAL" onAction="#handleBatal" 
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 80; -fx-font-size: 11;"/>
        <Button text="✅ BAYAR SEKARANG" onAction="#handleBayarDenda" 
                style="-fx-background-color: #1A5D34; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150; -fx-font-size: 11;"/>
    </HBox>

    <VBox spacing="2" style="-fx-background-color: #e8f4f8; -fx-padding: 8; -fx-border-radius: 5;">
        <HBox spacing="5">
            <Label text="🟢 Transfer:" textFill="#2c3e50" style="-fx-font-weight: bold; -fx-font-size: 10;"/>
            <Label text="Langsung LUNAS" textFill="#27ae60" style="-fx-font-size: 10;"/>
        </HBox>
        <HBox spacing="5">
            <Label text="🟠 Cash:" textFill="#2c3e50" style="-fx-font-weight: bold; -fx-font-size: 10;"/>
            <Label text="Menunggu Konfirmasi Admin" textFill="#f39c12" style="-fx-font-size: 10;"/>
        </HBox>
    </VBox>

</VBox>