<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15" xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.javagear.controllers.FormHubungiAdminController"
      prefWidth="400" prefHeight="350"
      style="-fx-background-color: white; -fx-padding: 25; -fx-border-color: #3498db; -fx-border-width: 2;">
    
    <VBox alignment="CENTER" spacing="5">
        <Label text="📞 HUBUNGI ADMIN" textFill="#2c3e50">
            <font><Font name="System Bold" size="20.0"/></font>
        </Label>
        <Label text="Butuh bantuan? Tulis pesan Anda di bawah ini." 
               textFill="#7f8c8d" style="-fx-font-size: 12px;"/>
    </VBox>

    <VBox spacing="5" VBox.vgrow="ALWAYS">
        <Label text="Pesan:" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <TextArea fx:id="fieldPesan" promptText="Contoh: Min, saya mau tanya soal..." 
                  prefRowCount="5" wrapText="true" 
                  style="-fx-background-color: #F5F7FA; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>
    </VBox>
    
    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Button text="❌ BATAL" onAction="#handleBatal" 
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 100;"/>
        
        <Button text="📤 KIRIM PESAN" onAction="#handleKirimPesan" 
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-width: 150;"/>
    </HBox>
    
</VBox>